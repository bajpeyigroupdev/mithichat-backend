NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/mithichat
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_SECRET_KEY=replace-with-a-random-encryption-key

# Existing Agora calling
AGORA_APP_ID=
APP_CERTIFICATE=

# Consent-gated Agora Cloud Recording
RECORDING_ENABLED=false
CALL_RECORDING_PROVIDER=agora
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_RECORDING_STORAGE_VENDOR=1
AGORA_RECORDING_STORAGE_REGION_CODE=14
RECORDING_CONSENT_POLICY_VERSION=1
RECORDING_CONSENT_DISCLOSURE=This call may be recorded only if both participants agree.
RECORDING_RETENTION_DAYS=30
RECORDING_WEBHOOK_SECRET=
RECORDING_WORKER_ENABLED=true
RECORDING_WORKER_POLL_MS=5000

# Private S3 or S3-compatible object storage. Never use a public bucket.
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_REGION=ap-south-1
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY_ID=
RECORDING_STORAGE_SECRET_ACCESS_KEY=
RECORDING_STORAGE_FORCE_PATH_STYLE=false

# Vendor-neutral AI boundary. Defaults target OpenAI-compatible endpoints.
TRANSCRIPTION_ENABLED=false
AI_ANALYSIS_ENABLED=false
AI_PROVIDER=openai
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_ANALYSIS_MODEL=gpt-5-mini
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_MODERATION_ALERT_THRESHOLD=0.75
AI_MAX_TRANSCRIPT_CHARS=120000
AI_MAX_MEDIA_BYTES=524288000

# Existing integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_CLIENT_ID=
